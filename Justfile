[windows]
set shell := ["powershell.exe", "-NoLogo", "-Command"]

# Show help
help:
    @just --list

# Clean autogenerated files
[unix]
clean:
    rm -rf dist
    find . -type f -name "*.DS_Store" -ls -delete
    find . | grep -E "(__pycache__|\.pyc|\.pyo)" | xargs rm -rf
    find . | grep -E ".pytest_cache" | xargs rm -rf
    find . | grep -E ".ipynb_checkpoints" | xargs rm -rf
    rm -f .coverage

# Clean autogenerated files
[windows]
clean:
    Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; $null
    Get-ChildItem -Recurse -Filter "*.DS_Store" | Remove-Item -Force; $null
    Get-ChildItem -Recurse -Directory -Include "__pycache__", ".pytest_cache", ".ipynb_checkpoints" | Remove-Item -Recurse -Force; $null
    Get-ChildItem -Recurse -Include "*.pyc", "*.pyo" | Remove-Item -Force; $null
    Remove-Item -Force .coverage -ErrorAction SilentlyContinue; $null

# Clean logs
[windows]
clean-logs:
    Remove-Item -Recurse -Force logs\** -ErrorAction SilentlyContinue

# Clean logs
[unix]
clean-logs:
    rm -rf logs/**

# Run pre-commit hooks
format:
    pre-commit run -a

# Merge changes from main branch to your current branch
sync:
    git pull
    git pull origin main

# Run not slow tests
test:
    pytest -k "not slow"

# Run all tests
test-full:
    pytest

# Train the model
train:
    python src/train.py
